      (pins J5-A5 R10-1)
    )
    (net USB_CC2
      (pins J5-B5 R11-1)
    )
    (class kicad_default +24V_FUSED +24V_RAW +3V3 +5V BOOT EN FAN_GATE FAN_NEG
      FAN_PWM GND HEATER_PWM MAX_CS MAX_DO MAX_SCK SSR_GATE SSR_NEG THERMO_MINUS
      THERMO_PLUS USB_CC1 USB_CC2 USB_DN USB_DN_MCU USB_DP USB_DP_MCU USB_VBUS
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
